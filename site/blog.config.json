{
  "contentDir": "content/blog",
  "outDir": ".blog-build",
  "siteUrl": "https://tidy.talkwork.vip",
  "primaryLocale": "zh",
  "locales": [
    "zh",
    "en"
  ],
  "articleRoute": "/{locale}/blog/{permalink}/",
  "indexRoute": "/{locale}/blog/",
  "rssRoute": "/{locale}/blog/rss.xml",
  "categories": [
    "space",
    "apps",
    "maintenance",
    "safety"
  ],
  "defaultAuthor": {
    "name": "Tidy",
    "url": "https://github.com/rambocode/tidy"
  },
  "readingTime": {
    "cjkCharsPerMinute": 350,
    "wordsPerMinute": 220,
    "minMinutes": 1
  },
  "allowedIframeHosts": [],
  "rss": {
    "mode": "summary",
    "maxItems": 20
  },
  "ctaBlocks": [
    "source",
    "issues"
  ],
  "missingTranslation": "hide",
  "permalinkLockFile": "content/blog/_permalinks.lock.json",
  "redirectsFile": "content/blog/_redirects.json"
}
