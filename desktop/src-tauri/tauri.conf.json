{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tidy",
  "version": "0.1.1",
  "identifier": "com.zhichi.tidy",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Tidy",
        "width": 1320,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "copyright": "© 2025 Tidy",
    "shortDescription": "macOS 清理与优化工具",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": {
          "width": 660,
          "height": 420
        },
        "appPosition": {
          "x": 165,
          "y": 196
        },
        "applicationFolderPosition": {
          "x": 495,
          "y": 196
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCRUQ3Rjg0RTVGRkEzRkMKUldUOG8vL2xoSC90Mnd5SVhnOVM1cUhQbGhiZFJOL3FERVNQenc1bU1PYTdUVVYvcEgzUzVYV1QK",
      "endpoints": [
        "https://github.com/rambocode/tidy/releases/latest/download/latest.json"
      ]
    }
  }
}
